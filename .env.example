# Export these variables before starting. This file is documentation, not auto-loaded.
BOT_TOKEN=
DATABASE_PATH=data/dating.sqlite3
# Optional: numeric Telegram ID; user must have started the bot to receive reports.
ADMIN_ID=
# Automatic backups: default is backups/ beside the database; empty disables.
# BACKUP_DIR=data/backups
# Mini App HTTP server; use a public HTTPS reverse proxy for Telegram.
WEB_ENABLED=1
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Public HTTPS root URL. Leave unset until a real deployment exists.
WEBAPP_URL=
# Domain for the optional Compose HTTPS profile (DNS must point to the server).
APP_DOMAIN=
